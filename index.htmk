```html
<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Topup App Demo - DuitNow QR</title>
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#ed022a">
  <style>
    * {
      box-sizing: border-box;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    body {
      background-color: #f3f4f6;
      margin: 0;
      padding: 20px;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }
    .card {
      background: #ffffff;
      padding: 24px;
      border-radius: 16px;
      max-width: 420px;
      width: 100%;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
    }
    .header {
      text-align: center;
      margin-bottom: 20px;
    }
    .header h2 {
      margin: 0;
      color: #111827;
      font-size: 1.5rem;
    }
    .header p {
      margin: 6px 0 0;
      color: #6b7280;
      font-size: 0.875rem;
    }
    .form-group {
      margin-bottom: 16px;
    }
    label {
      display: block;
      font-size: 0.875rem;
      font-weight: 600;
      margin-bottom: 6px;
      color: #374151;
    }
    input, select {
      width: 100%;
      padding: 12px;
      border-radius: 8px;
      border: 1px solid #d1d5db;
      font-size: 1rem;
      outline: none;
      transition: border-color 0.2s;
    }
    input:focus, select:focus {
      border-color: #ed022a;
    }
    .btn-primary {
      width: 100%;
      padding: 14px;
      background-color: #ed022a;
      color: #ffffff;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.2s;
    }
    .btn-primary:hover {
      background-color: #c80223;
    }
    .btn-primary:disabled {
      background-color: #9ca3af;
      cursor: not-allowed;
    }

    /* Modal Styling */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.6);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 1000;
      padding: 16px;
    }
    .modal-overlay.active {
      display: flex;
    }
    .modal-content {
      background: #ffffff;
      padding: 24px;
      border-radius: 16px;
      max-width: 360px;
      width: 100%;
      text-align: center;
      position: relative;
      animation: modalFadeIn 0.3s ease-out;
    }
    @keyframes modalFadeIn {
      from { transform: translateY(20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .duitnow-header {
      background-color: #ed022a;
      color: white;
      padding: 8px 16px;
      border-radius: 6px;
      display: inline-block;
      font-weight: 700;
      font-size: 0.9rem;
      letter-spacing: 0.5px;
      margin-bottom: 12px;
    }
    .qr-container {
      background: #ffffff;
      border: 2px dashed #e5e7eb;
      border-radius: 12px;
      padding: 16px;
      margin: 16px 0;
      display: inline-block;
    }
    .qr-container img {
      width: 200px;
      height: 200px;
      display: block;
    }
    .amount-tag {
      font-size: 1.25rem;
      font-weight: 700;
      color: #111827;
      margin-bottom: 4px;
    }
    .details-text {
      font-size: 0.85rem;
      color: #6b7280;
      margin-bottom: 16px;
    }
    .sim-buttons {
      display: flex;
      gap: 8px;
      margin-top: 16px;
    }
    .btn-sim-success {
      flex: 1;
      padding: 10px;
      background-color: #10b981;
      color: white;
      border: none;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-sim-cancel {
      flex: 1;
      padding: 10px;
      background-color: #ef4444;
      color: white;
      border: none;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
    }
    #statusAlert {
      margin-top: 16px;
      padding: 12px;
      border-radius: 8px;
      font-size: 0.875rem;
      display: none;
    }
    .status-success {
      background-color: #d1fae5;
      color: #065f46;
      border: 1px solid #a7f3d0;
    }
    .status-error {
      background-color: #fee2e2;
      color: #991b1b;
      border: 1px solid #fca5a5;
    }
  </style>
</head>
<body>

  <div class="card">
    <div class="header">
      <h2>Topup Prepaid</h2>
      <p>Pilih telco dan buat bayaran imbasan DuitNow QR</p>
    </div>

    <form id="topupForm">
      <div class="form-group">
        <label for="phone">Nombor Telefon</label>
        <input type="tel" id="phone" placeholder="0123456789" required pattern="^[0-9]{10,11}$">
      </div>

      <div class="form-group">
        <label for="provider">Pembekal / Telco</label>
        <select id="provider" required>
          <option value="">-- Pilih Telco --</option>
          <option value="CELCOM">Celcom</option>
          <option value="DIGI">Digi</option>
          <option value="MAXIS">Maxis / Hotlink</option>
          <option value="UMOBILE">U Mobile</option>
        </select>
      </div>

      <div class="form-group">
        <label for="amount">Amaun (RM)</label>
        <select id="amount" required>
          <option value="5">RM 5.00</option>
          <option value="10" selected>RM 10.00</option>
          <option value="30">RM 30.00</option>
          <option value="50">RM 50.00</option>
        </select>
      </div>

      <button type="submit" class="btn-primary" id="btnPay">Bayar dengan DuitNow QR</button>
    </form>

    <div id="statusAlert"></div>
  </div>

  <!-- DuitNow QR Modal -->
  <div class="modal-overlay" id="qrModal">
    <div class="modal-content">
      <div class="duitnow-header">DuitNow QR</div>
      <div class="amount-tag" id="modalAmount">RM 0.00</div>
      <div class="details-text" id="modalDetails">Celcom - 0123456789</div>

      <div class="qr-container">
        <!-- Generates dynamic QR mockup using API -->
        <img id="qrImage" src="" alt="DuitNow QR Code">
      </div>

      <p style="font-size: 0.8rem; color: #6b7280; margin: 0;">Imbas menggunakan sebarang aplikasi Bank atau e-Wallet di Malaysia.</p>

      <!-- Control Buttons to Simulate Webhook/Payment Flow -->
      <div class="sim-buttons">
        <button type="button" class="btn-sim-success" id="btnSimSuccess">Simulasi Bayaran</button>
        <button type="button" class="btn-sim-cancel" id="btnSimCancel">Batal</button>
      </div>
    </div>
  </div>

  <script>
    // Register Service Worker
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('sw.js')
        .then(() => console.log('Service Worker Registered'))
        .catch(err => console.error('SW Registration Failed:', err));
    }

    const BACKEND_API_URL = 'https://backend-demo-anda.vercel.app/api/topup'; // Replace with Vercel API endpoint

    const topupForm = document.getElementById('topupForm');
    const qrModal = document.getElementById('qrModal');
    const modalAmount = document.getElementById('modalAmount');
    const modalDetails = document.getElementById('modalDetails');
    const qrImage = document.getElementById('qrImage');
    const statusAlert = document.getElementById('statusAlert');

    const btnSimSuccess = document.getElementById('btnSimSuccess');
    const btnSimCancel = document.getElementById('btnSimCancel');

    let currentOrder = null;

    // Form submission handler: Generate QR Modal
    topupForm.addEventListener('submit', (e) => {
      e.preventDefault();

      const phone = document.getElementById('phone').value;
      const provider = document.getElementById('provider').value;
      const amount = document.getElementById('amount').value;

      currentOrder = { phone, provider, amount };

      // Update Modal Info
      modalAmount.innerText = `RM ${parseFloat(amount).toFixed(2)}`;
      modalDetails.innerText = `${provider} • ${phone}`;

      // Dynamically load a mock QR code image using quickchart API
      const qrData = `DUITNOW-PAYMENT-${provider}-${phone}-${amount}`;
      qrImage.src = `https://quickchart.io/qr?text=${encodeURIComponent(qrData)}&size=200`;

      // Display Modal
      statusAlert.style.display = 'none';
      qrModal.classList.add('active');
    });

    // Simulate successful payment confirmation
    btnSimSuccess.addEventListener('click', async () => {
      qrModal.classList.remove('active');
      showStatus('Memproses pesanan topup dengan pembekal...', 'info');

      try {
        // Send request to relay backend / Provider API
        const response = await fetch(BACKEND_API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(currentOrder)
        });

        const data = await response.json();

        if (response.ok && data.status === 'SUCCESS') {
          showStatus(`Bayaran & Topup Berjaya! ID Transaksi: ${data.trx_id || 'TRX-MOCK-999'}`, 'success');
          topupForm.reset();
        } else {
          throw new Error(data.message || 'Transaksi topup gagal diproses oleh pembekal.');
        }
      } catch (error) {
        // Fallback for offline or mock environment
        console.warn('API Error (Fallback Active):', error.message);
        showStatus(`[Mod Demo] Bayaran DuitNow disahkan! Topup RM ${currentOrder.amount} ke ${currentOrder.phone} berjaya diproses.`, 'success');
        topupForm.reset();
      }
    });

    // Cancel Payment Modal
    btnSimCancel.addEventListener('click', () => {
      qrModal.classList.remove('active');
      showStatus('Bayaran DuitNow dibatalkan oleh pengguna.', 'error');
    });

    function showStatus(message, type) {
      statusAlert.innerText = message;
      statusAlert.style.display = 'block';
      if (type === 'success') {
        statusAlert.className = 'status-success';
      } else if (type === 'error') {
        statusAlert.className = 'status-error';
      } else {
        statusAlert.className = '';
        statusAlert.style.backgroundColor = '#e0f2fe';
        statusAlert.style.color = '#0369a1';
        statusAlert.style.border = '1px solid #bae6fd';
      }
    }
  </script>
</body>
</html>
```
